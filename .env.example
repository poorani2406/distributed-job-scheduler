# .env.example
# --- Database Configuration ---
# Local/Docker compose: postgresql+asyncpg://scheduler:scheduler@db:5432/scheduler
# Render/Production: Standard postgres://... or postgresql://... (automatically normalized to +asyncpg in code)
DATABASE_URL=postgresql+asyncpg://scheduler:scheduler@db:5432/scheduler

# Legacy/Optional (can be left blank in production)
SYNC_DATABASE_URL=

# --- Security Configuration ---
# Set a strong, secure secret string in production!
JWT_SECRET=change_this_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS & Domains ---
# Comma-separated list of allowed frontend domains. Use * to allow development localhost.
CORS_ORIGINS=*

# --- Worker Telemetry ---
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=1
HEARTBEAT_INTERVAL_SECONDS=5
STALE_JOB_TIMEOUT_SECONDS=60

# --- Frontend Build Variables ---
# The URL of your API server backend. Set when building the production frontend container.
VITE_API_URL=http://localhost:8000